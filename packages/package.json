{
  "name": "@kemalcalak/design-editor-packages",
  "private": true,
  "description": "JS tooling for Design Editor (the Rust product lives in ../crates): the Chrome extension's lint and packaging scripts and the Iconify catalog generator.",
  "author": {
    "name": "kemalcalak"
  },
  "type": "module",
  "scripts": {
    "lint": "oxlint . && bun run check-extractor-sync && bun run check-sw-imports && bun run check-locales && bun run check-design-evidence",
    "check-extractor-sync": "bash de-chrome-extension/scripts/check-extractor-sync.sh",
    "check-sw-imports": "node de-chrome-extension/scripts/check-sw-imports.mjs",
    "check-locales": "node de-chrome-extension/scripts/check-locales.mjs",
    "check-design-evidence": "node de-chrome-extension/scripts/check-design-evidence.mjs",
    "check-extractor-sync:fix": "bash de-chrome-extension/scripts/check-extractor-sync.sh --fix",
    "build-extension": "bash de-chrome-extension/scripts/build-wasm.sh",
    "package-extension": "bash de-chrome-extension/scripts/package-extension.sh",
    "lint:fix": "oxlint --fix . && bun run check-extractor-sync:fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "generate-iconify-catalog": "node scripts/generate-iconify-catalog.mjs"
  },
  "devDependencies": {
    "@iconify-json/feather": "^1.2.1",
    "@iconify-json/lucide": "^1.2.93",
    "@iconify-json/material-symbols": "^1.2.96",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.71",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "typescript": "^5.7.2"
  },
  "packageManager": "bun@1.3.14"
}
