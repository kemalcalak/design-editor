[Unit]
Description=Design Editor supervised Global-to-CN relay edge
Wants=network-online.target
Requires=docker.service nftables.service
After=network-online.target nftables.service docker.service

[Service]
Type=simple
EnvironmentFile=/etc/design-editor/collab-relay-global.env
WorkingDirectory=/opt/design-editor
ExecStart=/opt/design-editor/deploy/collab-relay-edge/deploy-global.sh
Restart=always
RestartSec=5s
TimeoutStopSec=210s

[Install]
WantedBy=multi-user.target
