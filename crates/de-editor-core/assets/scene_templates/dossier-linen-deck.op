                          "type": "text",
                          "id": "t172",
                          "name": "para-number",
                          "content": "§3.2",
                          "fontFamily": "Inter",
                          "fontSize": 26,
                          "fontWeight": 500,
                          "fill": [
                            {
                              "type": "solid",
                              "color": "$c-thread"
                            }
                          ],
                          "lineHeight": 2.077,
                          "letterSpacing": 0,
                          "textGrowth": "fixed-width",
                          "width": 96,
                          "textAlign": "right"
                        },
                        {
                          "type": "frame",
                          "id": "f173",
                          "name": "paragraph",
                          "width": "fill_container",
                          "height": "fit_content",
                          "layout": "vertical",
                          "gap": 18,
                          "fill": [],
                          "children": [
                            {
                              "type": "text",
                              "id": "t171",
                              "name": "body",
                              "content": "Closure sits at 44% not because no one fixes things,\nbut because nothing requires logging the fix once it's done.\nNo log, no record; no record, nothing to recount.",
                              "fontFamily": "Inter",
                              "fontSize": 30,
                              "fontWeight": 400,
                              "fill": [
                                {
                                  "type": "solid",
                                  "color": "$c-ink"
                                }
                              ],
                              "lineHeight": 1.8,
                              "letterSpacing": 0,
                              "textGrowth": "fixed-width",
                              "width": 900
                            }
                          ]
                        }
                      ]
