                              "content": "Q: Can we trust stores' self-checks?",
                              "fontFamily": "Inter",
                              "fontSize": 30,
                              "fontWeight": 600,
                              "fill": [
                                {
                                  "type": "solid",
                                  "color": "$c-ink"
                                }
                              ],
                              "lineHeight": 1.4,
                              "letterSpacing": 0,
                              "textGrowth": "fixed-width",
                              "width": 900
                            },
                            {
                              "type": "text",
                              "id": "t322",
                              "name": "answer",
                              "content": "15% are audited, picked at random by regional managers and filed alongside.\nTwo mismatched audits in a row put a store back on manual checks.",
                              "fontFamily": "Inter",
                              "fontSize": 30,
                              "fontWeight": 400,
                              "fill": [
                                {
                                  "type": "solid",
                                  "color": "$c-ink-soft"
                                }
                              ],
                              "lineHeight": 1.65,
                              "letterSpacing": 0,
                              "textGrowth": "fixed-width",
                              "width": 900
                            }
                          ]
                        }
                      ]
                    },
