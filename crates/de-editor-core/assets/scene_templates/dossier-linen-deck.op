                        },
                        {
                          "type": "frame",
                          "id": "f30",
                          "name": "paragraph",
                          "width": "fill_container",
                          "height": "fit_content",
                          "layout": "vertical",
                          "gap": 18,
                          "fill": [],
                          "children": [
                            {
                              "type": "text",
                              "id": "t28",
                              "name": "body",
                              "content": "Spot checks rotate by region; a store is seen every 47 days.\nInspectors handwrite findings on site and key them in later,\na 1.8-day gap on average, so photos and forms often don't match.\nSpot checks aren't wrong; treating them as the whole picture is.",
                              "fontFamily": "Inter",
                              "fontSize": 30,
                              "fontWeight": 400,
                              "fill": [
                                {
                                  "type": "solid",
                                  "color": "$c-ink"
                                }
                              ],
                              "lineHeight": 1.8,
                              "letterSpacing": 0,
                              "textGrowth": "fixed-width",
                              "width": 900
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "f35",
                      "name": "numbered-para",
                      "width": "fill_container",
                      "height": "fit_content",
                      "layout": "horizontal",
                      "gap": 120,
