                      "fill": [],
                      "children": [
                        {
                          "type": "text",
                          "id": "t33",
                          "name": "para-number",
                          "content": "§1.2",
                          "fontFamily": "Inter",
                          "fontSize": 26,
                          "fontWeight": 500,
                          "fill": [
                            {
                              "type": "solid",
                              "color": "$c-thread"
                            }
                          ],
                          "lineHeight": 2.077,
                          "letterSpacing": 0,
                          "textGrowth": "fixed-width",
                          "width": 96,
                          "textAlign": "right"
                        },
                        {
                          "type": "frame",
                          "id": "f34",
                          "name": "paragraph",
                          "width": "fill_container",
                          "height": "fit_content",
                          "layout": "vertical",
                          "gap": 18,
                          "fill": [],
                          "children": [
                            {
                              "type": "text",
                              "id": "t32",
                              "name": "body",
                              "content": "Issues are reported in a group chat that also carries\nrotas, repairs and notices. Once a report scrolls away, it's gone.\nOf 1,342 reports last quarter, only 611 trace to a closed fix.",
                              "fontFamily": "Inter",
                              "fontSize": 30,
                              "fontWeight": 400,
                              "fill": [
                                {
                                  "type": "solid",
                                  "color": "$c-ink"
                                }
                              ],
                              "lineHeight": 1.8,
                              "letterSpacing": 0,
                              "textGrowth": "fixed-width",
                              "width": 900
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
