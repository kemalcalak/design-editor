                          "fill": [],
                          "children": [
                            {
                              "type": "text",
                              "id": "t290",
                              "name": "body",
                              "content": "By next March, every store logs a full inspection every week.\nNo one has to remember the photos; the process makes the record:\nif the checklist isn't finished, that day's inspection isn't done.\nOn Monday morning, regional managers won't see a summary sheet\nbut every open issue from last week, listed store by store.\nWe'll stop talking about coverage, since it's always 100%;\nwe'll talk about time to close, and why some stores run long.",
                              "fontFamily": "Inter",
                              "fontSize": 30,
                              "fontWeight": 400,
                              "fill": [
                                {
                                  "type": "solid",
                                  "color": "$c-ink"
                                }
                              ],
                              "lineHeight": 1.8,
                              "letterSpacing": 0,
