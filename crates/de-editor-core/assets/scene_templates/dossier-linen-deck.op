                              "content": "Q: How much extra time does it cost stores?",
                              "fontFamily": "Inter",
                              "fontSize": 30,
                              "fontWeight": 600,
                              "fill": [
                                {
                                  "type": "solid",
                                  "color": "$c-ink"
                                }
                              ],
                              "lineHeight": 1.4,
                              "letterSpacing": 0,
                              "textGrowth": "fixed-width",
                              "width": 900
                            },
                            {
                              "type": "text",
                              "id": "t329",
                              "name": "answer",
                              "content": "A self-check takes 12 minutes, 4 fewer than today's paper form.\nThe time comes off data entry, not off the inspection.",
                              "fontFamily": "Inter",
                              "fontSize": 30,
                              "fontWeight": 400,
                              "fill": [
