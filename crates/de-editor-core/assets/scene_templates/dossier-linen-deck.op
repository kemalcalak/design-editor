                          "fontFamily": "Inter",
                          "fontSize": 26,
                          "fontWeight": 500,
                          "fill": [
                            {
                              "type": "solid",
                              "color": "$c-thread"
                            }
                          ],
                          "lineHeight": 2.077,
                          "letterSpacing": 0,
                          "textGrowth": "fixed-width",
                          "width": 96,
                          "textAlign": "right"
                        },
                        {
                          "type": "frame",
                          "id": "f38",
