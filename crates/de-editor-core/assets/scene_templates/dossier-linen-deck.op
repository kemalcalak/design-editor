                          "width": 96,
                          "textAlign": "right"
                        },
                        {
                          "type": "frame",
                          "id": "f169",
                          "name": "paragraph",
                          "width": "fill_container",
                          "height": "fit_content",
                          "layout": "vertical",
                          "gap": 18,
                          "fill": [],
                          "children": [
                            {
                              "type": "text",
                              "id": "t167",
                              "name": "body",
                              "content": "Rotas set the sample, and rotas skip the hardest-to-reach stores.\nThe more remote or short-staffed a store, the longer between visits,\nso the stores with the most issues are the ones we know least.\nThat's not poor execution; it's bias built into the sampling.",
                              "fontFamily": "Inter",
                              "fontSize": 30,
                              "fontWeight": 400,
                              "fill": [
                                {
                                  "type": "solid",
                                  "color": "$c-ink"
                                }
                              ],
                              "lineHeight": 1.8,
                              "letterSpacing": 0,
                              "textGrowth": "fixed-width",
                              "width": 900
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "f174",
                      "name": "numbered-para",
                      "width": "fill_container",
