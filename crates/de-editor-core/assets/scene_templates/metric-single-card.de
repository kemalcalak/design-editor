{
  "version": "1.0.0",
  "name": "single-metric-card-grid-1x1",
  "variables": {
    "c-white": {
      "type": "color",
      "value": "#FFFFFF"
    },
    "c-paper": {
      "type": "color",
      "value": "#F2F2F2"
    },
    "c-rule": {
      "type": "color",
      "value": "#D1D1D1"
    },
    "c-grey": {
      "type": "color",
      "value": "#696969"
    },
    "c-black": {
      "type": "color",
      "value": "#121212"
    },
    "c-signal": {
      "type": "color",
      "value": "#CC342C"
    }
  },
  "children": [
    {
      "type": "frame",
      "id": "f1",
      "name": "single-metric-card-grid",
      "width": 1080,
      "height": 1080,
      "layout": "vertical",
      "padding": [
        88,
        80,
        112,
        80
      ],
      "gap": 0,
      "justifyContent": "space_between",
      "alignItems": "start",
      "fill": [
        {
          "type": "solid",
          "color": "$c-white"
        }
      ],
      "clipContent": true,
      "children": [
        {
          "type": "frame",
          "id": "f6",
          "name": "card-header",
          "width": "fill_container",
          "height": "fit_content",
          "layout": "vertical",
          "gap": 20,
          "alignItems": "start",
          "fill": [],
          "children": [
            {
              "type": "frame",
              "id": "f4",
              "name": "mark-row",
              "width": "fit_content",
              "height": "fit_content",
              "layout": "horizontal",
              "gap": 16,
              "alignItems": "center",
              "fill": [],
              "children": [
                {
                  "type": "rectangle",
                  "id": "r2",
                  "name": "black-bar",
                  "width": 218,
                  "height": 10,
                  "fill": [
                    {
                      "type": "solid",
                      "color": "$c-black"
                    }
                  ]
                },
                {
                  "type": "rectangle",
                  "id": "r3",
                  "name": "signal-square",
                  "width": 24,
                  "height": 24,
                  "fill": [
                    {
                      "type": "solid",
                      "color": "$c-signal"
                    }
                  ]
                }
              ]
            },
            {
              "type": "text",
              "id": "t5",
              "name": "label",
              "content": "Quarterly metric · 2026 Q2",
              "fontFamily": "Inter",
              "fontSize": 32,
              "fontWeight": 500,
              "fill": [
                {
                  "type": "solid",
                  "color": "$c-grey"
                }
              ],
              "lineHeight": 1.5,
              "letterSpacing": 0.6,
              "textGrowth": "fixed-width",
              "width": "fill_container"
            }
          ]
        },
        {
          "type": "frame",
          "id": "f9",
          "name": "value-row",
          "width": "fit_content",
          "height": "fit_content",
          "layout": "horizontal",
          "gap": 20,
          "alignItems": "end",
          "fill": [],
          "children": [
            {
              "type": "text",
              "id": "t7",
              "name": "value",
              "content": "68",
              "fontFamily": "Inter",
              "fontSize": 168,
              "fontWeight": 700,
              "fill": [
                {
                  "type": "solid",
                  "color": "$c-black"
                }
              ],
              "lineHeight": 1.05,
              "letterSpacing": -1.7,
              "textGrowth": "auto",
              "width": "fit_content"
            },
            {
              "type": "text",
              "id": "t8",
              "name": "unit",
              "content": "%",
              "fontFamily": "Inter",
              "fontSize": 48,
              "fontWeight": 600,
              "fill": [
                {
                  "type": "solid",
                  "color": "$c-grey"
                }
              ],
              "lineHeight": 1.0,
              "letterSpacing": 0,
              "textGrowth": "auto",
              "width": "fit_content"
            }
          ]
        },
        {
          "type": "frame",
          "id": "f11",
          "name": "definition",
          "width": "fill_container",
          "height": "fit_content",
          "layout": "vertical",
          "gap": 16,
          "alignItems": "start",
          "fill": [],
          "children": [
            {
              "type": "text",
              "id": "t10",
              "name": "explanation",
              "content": "68% of people who started from a template made a second design within two weeks.",
              "fontFamily": "Inter",
              "fontSize": 40,
              "fontWeight": 400,
              "fill": [
                {
                  "type": "solid",
                  "color": "$c-black"
                }
              ],
              "lineHeight": 1.7,
              "letterSpacing": 0.8,
              "textGrowth": "fixed-width",
              "width": "fill_container"
            }
          ]
        },
        {
          "type": "frame",
          "id": "f14",
          "name": "source",
          "width": "fill_container",
          "height": "fit_content",
          "layout": "vertical",
          "gap": 20,
          "alignItems": "start",
          "fill": [],
          "children": [
            {
              "type": "rectangle",
              "id": "r12",
              "name": "divider",
              "width": "fill_container",
              "height": 1,
              "fill": [
                {
                  "type": "solid",
                  "color": "$c-rule"
                }
              ]
            },
            {
              "type": "text",
              "id": "t13",
              "name": "source-row",
              "content": "Basis: new docs from Apr 1 to Jun 30, 2026, unique users.",
              "fontFamily": "Inter",
              "fontSize": 32,
              "fontWeight": 400,
              "fill": [
                {
                  "type": "solid",
                  "color": "$c-grey"
                }
              ],
              "lineHeight": 1.5,
              "letterSpacing": 0.6,
              "textGrowth": "fixed-width",
              "width": "fill_container"
            }
          ]
        }
      ],
      "x": 0,
      "y": 0
    }
  ]
}
