                                },
                                {
                                  "type": "text",
                                  "id": "t96",
                                  "name": "definition-body",
                                  "content": "Let f(x) be differentiable on (a, b). If f'(x) > 0 throughout the interval, f(x) is increasing on (a, b); if f'(x) < 0 throughout, it is decreasing.",
                                  "fontFamily": "Inter",
                                  "fontSize": 30,
                                  "fontWeight": 400,
                                  "fill": [
