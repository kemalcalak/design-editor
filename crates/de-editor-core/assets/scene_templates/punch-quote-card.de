                      "fill": [
                        {
                          "type": "solid",
                          "color": "$c-bg"
                        }
                      ],
                      "lineHeight": 1.25,
                      "letterSpacing": 0,
                      "textGrowth": "auto",
                      "width": "fit_content"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "t8",
                  "name": "note",
                  "content": "Swap \"when I'm ready\" for \"five minutes, now.\"\nThe rest figures itself out once you're moving.",
                  "fontFamily": "Inter",
                  "fontSize": 40,
                  "fontWeight": 400,
                  "fill": [
                    {
                      "type": "solid",
                      "color": "$c-muted"
                    }
                  ],
                  "lineHeight": 1.7,
                  "letterSpacing": 0,
                  "textGrowth": "fixed-width",
                  "width": "fill_container"
