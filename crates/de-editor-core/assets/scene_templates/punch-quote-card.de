                          "fontSize": 34,
                          "fontWeight": 700,
                          "fill": [
                            {
                              "type": "solid",
                              "color": "$c-accent"
                            }
                          ],
                          "lineHeight": 1.0,
                          "letterSpacing": 0,
                          "textGrowth": "auto",
                          "width": "fit_content"
