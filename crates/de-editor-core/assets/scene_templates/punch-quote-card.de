{
  "version": "1.0.0",
  "name": "quote-card-poster-3x4",
  "variables": {
    "c-bg": {
      "type": "color",
      "value": "#131110"
    },
    "c-surface": {
      "type": "color",
      "value": "#1E1B19"
    },
    "c-ink": {
      "type": "color",
      "value": "#FFFFFF"
    },
    "c-muted": {
      "type": "color",
      "value": "#B5ADA2"
    },
    "c-accent": {
      "type": "color",
      "value": "#FFE04D"
    },
    "c-border": {
      "type": "color",
      "value": "#33302C"
    },
    "c-glow": {
      "type": "color",
      "value": "#FFE04D22"
    },
    "c-glow-out": {
      "type": "color",
      "value": "#FFE04D00"
    }
  },
  "children": [
    {
      "type": "frame",
      "id": "f21",
      "name": "quote-card-poster",
      "width": 1080,
      "height": 1440,
      "layout": "none",
      "fill": [
        {
          "type": "solid",
          "color": "$c-bg"
        }
      ],
      "clipContent": true,
      "children": [
        {
          "type": "frame",
          "id": "f1",
          "name": "quote-card-body",
          "width": "fill_container",
          "height": "fill_container",
          "layout": "vertical",
          "padding": [
            96,
            88
          ],
          "gap": 0,
          "justifyContent": "space_between",
          "alignItems": "start",
          "fill": [],
          "children": [
            {
              "type": "frame",
              "id": "f5",
              "name": "card-header",
              "width": "fill_container",
              "height": "fit_content",
              "layout": "vertical",
              "gap": 30,
              "alignItems": "start",
              "fill": [],
              "children": [
                {
                  "type": "frame",
                  "id": "f2",
                  "name": "tag",
                  "width": "fit_content",
                  "height": "fit_content",
                  "layout": "horizontal",
                  "padding": [
                    12,
                    26
                  ],
                  "gap": 0,
                  "cornerRadius": 999,
                  "alignItems": "center",
                  "justifyContent": "center",
                  "fill": [
                    {
                      "type": "solid",
                      "color": "$c-accent"
                    }
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "t3",
                      "name": "tag-text",
                      "content": "Contrarian · 03",
                      "fontFamily": "Inter",
                      "fontSize": 32,
                      "fontWeight": 700,
                      "fill": [
                        {
                          "type": "solid",
                          "color": "$c-bg"
                        }
                      ],
                      "lineHeight": 1.4,
                      "letterSpacing": 0,
                      "textGrowth": "auto",
                      "width": "fit_content"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "t4",
                  "name": "main-title",
                  "content": "It's not time.\nIt's starting.",
                  "fontFamily": "Inter",
                  "fontSize": 120,
                  "fontWeight": 700,
                  "fill": [
                    {
                      "type": "solid",
                      "color": "$c-ink"
                    }
                  ],
                  "lineHeight": 1.15,
                  "letterSpacing": -2,
                  "textGrowth": "fixed-width",
                  "width": "fill_container"
                }
              ]
            },
            {
              "type": "frame",
              "id": "f9",
              "name": "claim",
              "width": "fill_container",
              "height": "fit_content",
              "layout": "vertical",
              "gap": 30,
              "alignItems": "start",
              "fill": [],
              "children": [
                {
                  "type": "frame",
                  "id": "f6",
                  "name": "tagline-bar",
                  "width": "fit_content",
                  "height": "fit_content",
