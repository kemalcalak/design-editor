      "children": [
        {
          "type": "frame",
          "id": "f79",
          "name": "page-title",
          "width": 1680,
          "height": "fit_content",
          "layout": "vertical",
          "gap": 24,
          "alignItems": "start",
          "fill": [],
          "x": 112,
          "y": 96,
          "children": [
            {
              "type": "text",
              "id": "t78",
              "name": "heading",
              "content": "We know light shifts foraging,\nbut not whether song shifts too",
              "fontFamily": "Inter",
              "fontSize": 60,
              "fontWeight": 700,
              "fill": [
                {
                  "type": "solid",
                  "color": "$c-graphite"
