              "name": "index",
              "content": "03",
              "fontFamily": "Inter",
              "fontSize": 24,
              "fontWeight": 500,
              "fill": [
                {
                  "type": "solid",
                  "color": "$c-faint"
                }
              ],
              "lineHeight": 1.45,
              "letterSpacing": 0,
              "textGrowth": "fixed-width",
              "width": 528
            },
            {
              "type": "text",
              "id": "t89",
              "name": "subheading",
              "content": "Measure both, same place, same time",
              "fontFamily": "Inter",
              "fontSize": 36,
              "fontWeight": 600,
              "fill": [
                {
                  "type": "solid",
                  "color": "$c-graphite"
                }
              ],
              "lineHeight": 1.35,
              "letterSpacing": 0,
              "textGrowth": "fixed-width",
              "width": "fill_container"
            },
            {
              "type": "text",
              "id": "t90",
              "name": "body",
              "content": "We log ground light and song\nonset together at each site\nand report a dose-response\ncurve, not a correlation.",
              "fontFamily": "Inter",
              "fontSize": 30,
              "fontWeight": 400,
              "fill": [
