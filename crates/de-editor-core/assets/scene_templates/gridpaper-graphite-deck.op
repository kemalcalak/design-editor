          "fill": [],
          "x": 112,
          "y": 384,
          "children": [
            {
              "type": "text",
              "id": "t80",
              "name": "index",
              "content": "01",
              "fontFamily": "Inter",
              "fontSize": 24,
              "fontWeight": 500,
              "fill": [
                {
                  "type": "solid",
                  "color": "$c-faint"
                }
              ],
              "lineHeight": 1.45,
              "letterSpacing": 0,
              "textGrowth": "fixed-width",
              "width": 528
            },
            {
              "type": "text",
              "id": "t81",
              "name": "subheading",
              "content": "Night lighting keeps spreading",
              "fontFamily": "Inter",
              "fontSize": 36,
              "fontWeight": 600,
              "fill": [
                {
                  "type": "solid",
                  "color": "$c-graphite"
                }
              ],
              "lineHeight": 1.35,
              "letterSpacing": 0,
              "textGrowth": "fixed-width",
              "width": "fill_container"
            },
            {
              "type": "text",
              "id": "t82",
              "name": "body",
              "content": "Artificially lit area grows\nabout 2% a year worldwide.\nIn our three cities, median\nground light rose 5 to 12 lux.",
              "fontFamily": "Inter",
              "fontSize": 30,
              "fontWeight": 400,
              "fill": [
                {
                  "type": "solid",
                  "color": "$c-soft"
                }
              ],
              "lineHeight": 1.7,
              "letterSpacing": 0,
              "textGrowth": "fixed-width",
              "width": "fill_container"
            }
          ]
        },
        {
          "type": "frame",
          "id": "f87",
          "name": "gap-02",
          "width": 528,
          "height": "fit_content",
          "layout": "vertical",
          "gap": 20,
          "alignItems": "start",
          "fill": [],
          "x": 688,
          "y": 384,
          "children": [
            {
              "type": "text",
              "id": "t84",
              "name": "index",
              "content": "02",
              "fontFamily": "Inter",
              "fontSize": 24,
              "fontWeight": 500,
              "fill": [
                {
                  "type": "solid",
                  "color": "$c-faint"
                }
              ],
              "lineHeight": 1.45,
              "letterSpacing": 0,
              "textGrowth": "fixed-width",
              "width": 528
            },
            {
              "type": "text",
              "id": "t85",
              "name": "subheading",
              "content": "Foraging has data, song doesn't",
              "fontFamily": "Inter",
              "fontSize": 36,
              "fontWeight": 600,
              "fill": [
                {
                  "type": "solid",
                  "color": "$c-graphite"
                }
              ],
              "lineHeight": 1.35,
              "letterSpacing": 0,
              "textGrowth": "fixed-width",
              "width": "fill_container"
            },
            {
              "type": "text",
              "id": "t86",
              "name": "body",
              "content": "Past work tracks foraging\nand migration timing. Song\nonset is patchy, and rarely\nmeasured with on-site light.",
              "fontFamily": "Inter",
              "fontSize": 30,
              "fontWeight": 400,
              "fill": [
                {
                  "type": "solid",
                  "color": "$c-soft"
                }
              ],
              "lineHeight": 1.7,
              "letterSpacing": 0,
              "textGrowth": "fixed-width",
              "width": "fill_container"
            }
          ]
        },
        {
          "type": "frame",
          "id": "f91",
          "name": "gap-03",
          "width": 528,
          "height": "fit_content",
          "layout": "vertical",
          "gap": 20,
          "alignItems": "start",
          "fill": [],
          "x": 1264,
