                      "color": "$c-inv-muted"
                    }
                  ],
                  "lineHeight": 1.4,
                  "letterSpacing": 0,
                  "textGrowth": "auto",
                  "width": "fit_content"
                }
              ]
            }
          ]
        }
      ],
      "x": 0,
      "y": 0
    }
  ]
}
