            {
              "type": "text",
              "id": "t73",
              "name": "right-column-body",
              "content": "A line sits on the page; a card on content.\nA rule spans the type area and never flexes\nwith the text; it divides space, not ownership.",
              "fontFamily": "Inter",
              "fontSize": 32,
              "fontWeight": 400,
              "fill": [
