            {
              "type": "text",
              "id": "t67",
              "name": "left-column-body",
              "content": "The usual move gives each column\na rounded card and a tint of its own.\nThey are apart, but readers see\ntwo cards, not two halves\nof one piece.",
              "fontFamily": "Inter",
              "fontSize": 32,
              "fontWeight": 400,
              "fill": [
                {
