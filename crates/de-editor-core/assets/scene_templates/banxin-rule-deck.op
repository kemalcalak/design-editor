          "x": 120,
          "y": 264,
          "children": [
            {
              "type": "text",
              "id": "t44",
              "name": "body",
              "content": "Screens reduce the type area to equal padding,\nso every page starts and ends in the same place.\nOld books did the opposite: notes up top, folios below,\nnever the same depth, so the page had a direction.\nThis deck sets the head at 144, the foot at 108;\nthe extra covers the edge heads block on a projector.",
              "fontFamily": "Inter",
              "fontSize": 32,
              "fontWeight": 400,
              "fill": [
                {
                  "type": "solid",
                  "color": "$c-ink"
                }
              ],
              "lineHeight": 1.75,
              "letterSpacing": 0,
              "textGrowth": "fixed-width",
