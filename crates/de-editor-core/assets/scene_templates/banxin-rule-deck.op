              "width": "fill_container"
            },
            {
              "type": "text",
              "id": "t68",
              "name": "left-column-cont",
              "content": "Cards also need padding,\nso the same type area holds fewer words,\nand the lines get no shorter.",
              "fontFamily": "Inter",
              "fontSize": 32,
              "fontWeight": 400,
              "fill": [
                {
