{
  "version": "1.0.0",
  "name": "checklist-card-notebook-style-4x5",
  "variables": {
    "c-bg": {
      "type": "color",
      "value": "#EEF0F3"
    },
    "c-card": {
      "type": "color",
      "value": "#FFFFFF"
    },
    "c-ink": {
      "type": "color",
      "value": "#0C0D0F"
    },
    "c-muted": {
      "type": "color",
      "value": "#4A4D51"
    },
    "c-done": {
      "type": "color",
      "value": "#83878B"
    },
    "c-line": {
      "type": "color",
      "value": "#DCDEE0"
    },
    "c-box": {
      "type": "color",
      "value": "#7D8792"
    },
    "c-accent": {
      "type": "color",
      "value": "#3B596E"
    },
    "c-accent-soft": {
      "type": "color",
      "value": "#DEEAF3"
    }
  },
  "children": [
    {
      "type": "frame",
      "id": "f1",
      "name": "checklist-card-notebook-style",
      "width": 1080,
      "height": 1350,
      "layout": "vertical",
      "padding": [
        96,
        88
      ],
      "gap": 0,
      "justifyContent": "space_between",
      "alignItems": "start",
      "fill": [
        {
          "type": "solid",
          "color": "$c-bg"
        }
      ],
      "clipContent": true,
      "children": [
        {
          "type": "frame",
          "id": "f8",
          "name": "card-header",
          "width": "fill_container",
          "height": "fit_content",
          "layout": "vertical",
          "gap": 20,
          "alignItems": "start",
          "fill": [],
          "children": [
            {
              "type": "frame",
              "id": "f5",
              "name": "meta",
              "width": "fit_content",
              "height": "fit_content",
              "layout": "horizontal",
              "gap": 16,
              "alignItems": "center",
              "fill": [],
              "children": [
                {
                  "type": "frame",
                  "id": "f2",
                  "name": "tag",
                  "width": "fit_content",
                  "height": "fit_content",
                  "layout": "horizontal",
                  "padding": [
                    9,
                    20
                  ],
                  "gap": 0,
                  "cornerRadius": 999,
                  "alignItems": "center",
                  "justifyContent": "center",
                  "fill": [
                    {
                      "type": "solid",
                      "color": "$c-accent-soft"
                    }
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "t3",
                      "name": "tag-text",
                      "content": "Weekly plan",
                      "fontFamily": "Inter",
                      "fontSize": 32,
                      "fontWeight": 600,
                      "fill": [
                        {
                          "type": "solid",
                          "color": "$c-accent"
                        }
                      ],
                      "lineHeight": 1.4,
                      "letterSpacing": 0,
                      "textGrowth": "auto",
                      "width": "fit_content"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "t4",
                  "name": "date",
                  "content": "2026 / 08 · Week 2",
                  "fontFamily": "Inter",
                  "fontSize": 32,
                  "fontWeight": 500,
                  "fill": [
                    {
                      "type": "solid",
                      "color": "$c-muted"
                    }
                  ],
                  "lineHeight": 1.4,
                  "letterSpacing": 0,
                  "textGrowth": "auto",
                  "width": "fit_content"
                }
              ]
            },
            {
              "type": "text",
              "id": "t6",
              "name": "main-title",
              "content": "Five things this week",
              "fontFamily": "Inter",
              "fontSize": 64,
              "fontWeight": 700,
              "fill": [
                {
                  "type": "solid",
                  "color": "$c-ink"
                }
              ],
              "lineHeight": 1.3,
              "letterSpacing": 0,
              "textGrowth": "fixed-width",
              "width": "fill_container"
            },
            {
              "type": "text",
              "id": "t7",
              "name": "subtitle",
              "content": "If it doesn't fit, it's not for this week.",
              "fontFamily": "Inter",
              "fontSize": 40,
              "fontWeight": 400,
              "fill": [
                {
                  "type": "solid",
                  "color": "$c-muted"
                }
              ],
              "lineHeight": 1.7,
              "letterSpacing": 0,
              "textGrowth": "fixed-width",
              "width": "fill_container"
            }
          ]
        },
        {
          "type": "frame",
          "id": "f40",
          "name": "checklist-card",
          "width": "fill_container",
          "height": "fit_content",
